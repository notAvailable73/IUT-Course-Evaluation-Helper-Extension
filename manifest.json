{
  "manifest_version": 3,
  "name": "IUT Course Evaluation Helper",
  "description": "Helps IUT students quickly fill course evaluation forms on SIS.",
  "version": "1.3.0",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "images/logo.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sis.iutoic-dhaka.edu/evaluate-course/*",
        "https://sis.iutoic-dhaka.edu/evaluation-list*"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://sis.iutoic-dhaka.edu/*"
  ],
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "iut-evaluation-helper@extension.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
